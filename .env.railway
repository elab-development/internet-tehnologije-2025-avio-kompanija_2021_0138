# Railway Environment Variables
# Kopirajte ovo u Railway dashboard > Variables

# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_SETTINGS_MODULE=flight_backend.settings
ALLOWED_HOSTS=*

# Database (Railway daje automatski)
# DATABASE_URL=postgresql://...

# CORS
CORS_ALLOWED_ORIGINS=https://your-app.railway.app,http://localhost:3000,http://localhost:5173

# Railway specific
RAILWAY_STATIC_URL=https://your-app.railway.app/static/
STATIC_URL=https://your-app.railway.app/static/
STATIC_ROOT=/app/staticfiles

# Optional: Redis (ako Railway pruži)
# REDIS_URL=redis://...

# Email (opciono)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend